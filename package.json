{
  "name": "eslint-plugin-browser-compat",
  "type": "module",
  "version": "0.0.2",
  "description": "An ESLint plugin for checking browser compatibility.",
  "author": "Henrik Wenz <handtrix@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/handtrix/eslint-plugin-browser-compat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handtrix/eslint-plugin-browser-compat.git"
  },
  "bugs": {
    "url": "https://github.com/handtrix/eslint-plugin-browser-compat/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "browserslist": "^4.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdn/browser-compat-data": "^8.0.4",
    "@types/node": "^25.6.2",
    "@typescript-eslint/parser": "^8.37.0",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-eslint-plugin": "^7.4.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@mdn/browser-compat-data": "^8.0.4",
    "eslint": "^10.6.0"
  }
}
